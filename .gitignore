# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
venv/
.venv/

# Environment and Secrets (CRITICAL)
.env
.env.*
credentials.json
token.json
client_secrets.json

# Process IDs and Daemon Logs
logs/
*.pid
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Authentication & Credentials
config/auth_states/*
!config/auth_states/.gitkeep
token.json
credentials.json

# Local runtime data & screenshots
data/*
!data/.gitkeep
!data/screenshots/.gitkeep

# Persistent browser profiles (live session cookies — never commit)
!data/browser_profiles/
data/browser_profiles/*
!data/browser_profiles/.gitkeep
!data/browser_profiles/README.md


build/
dist/
*.egg-info/